// FlyWorkFlow backend — Prisma schema.
// Source of truth for entities from this point on (docs/data-model.md at the
// repository root now follows this file, not the other way around).

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev/CI; "rhel-openssl-3.0.x" matches the Amazon
  // Linux 2023 base of the Lambda Node.js container image (F3.4/F3.5).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  admin
  superadmin
}

enum IncidentPriority {
  high
  medium
  low
}

enum IncidentStatus {
  open
  on_pause
  closed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum MediaType {
  image
  video
  document
}

enum MediaStatus {
  uploaded
  pending
  error
}

enum AuditAction {
  created
  updated
  status_changed
  approved
  rejected
  deleted
  restored
}

enum NotificationType {
  assignment
  status_changed
  approval
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  projects      Project[]
  tags          Tag[]
  incidents     Incident[]
  auditLogs     AuditLog[]
  notifications Notification[]
  invitations   Invitation[]
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(member)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  // Account-level brute-force protection (F9.5). `@nestjs/throttler` counts
  // per IP in each Lambda instance's own memory, so it never saw a
  // distributed attempt spread across addresses converging on one account.
  // These two columns are in Postgres precisely because that is the one place
  // in this stack where a counter is genuinely global — see
  // `AuthService.validateCredentials`.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  organization      Organization       @relation(fields: [orgId], references: [id])
  ownedIncidents    Incident[]         @relation("IncidentOwner")
  assignedIncidents IncidentAssignee[]
  observedIncidents IncidentObserver[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  notifications     Notification[]     @relation("NotificationRecipient")
  sentInvitations   Invitation[]       @relation("InvitationInviter")
  exportToken       ExportToken?

  @@index([orgId])
}

model Project {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id])
  incidents    Incident[]
  plans        ProjectPlan[]

  @@index([orgId])
}

// Shared catalog, not organization-dependent — same 15 keys for every tenant.
model IncidentType {
  id     String @id @default(uuid())
  key    String @unique
  name   String
  nameEn String

  incidents Incident[]
}

model Incident {
  id          String @id @default(uuid())
  sequenceId  String
  orgId       String
  projectId   String
  typeId      String
  title       String
  description String

  priority IncidentPriority
  status   IncidentStatus
  approval ApprovalStatus   @default(pending)

  ownerId String

  deleted Boolean @default(false)

  // Embedded point, not a relation (see docs/data-model.md) — modeled as two
  // nullable scalars rather than Json so it stays directly queryable/typed.
  lat Float?
  lng Float?

  locationDescription String?
  dueDate             DateTime?
  closingDate         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  type         IncidentType @relation(fields: [typeId], references: [id])
  owner        User         @relation("IncidentOwner", fields: [ownerId], references: [id])

  assignees     IncidentAssignee[]
  observers     IncidentObserver[]
  tags          IncidentTag[]
  media         Media[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@unique([orgId, sequenceId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model IncidentAssignee {
  incidentId String
  userId     String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
}

model IncidentObserver {
  incidentId String
  userId     String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
}

model Tag {
  id    String @id @default(uuid())
  orgId String
  name  String
  color String

  organization Organization  @relation(fields: [orgId], references: [id])
  incidents    IncidentTag[]

  @@index([orgId])
}

model IncidentTag {
  incidentId String
  tagId      String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([incidentId, tagId])
}

model Media {
  id         String      @id @default(uuid())
  incidentId String
  name       String
  type       MediaType
  format     String
  size       Int
  status     MediaStatus
  url        String
  createdAt  DateTime    @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// Project-level attachments (roadmap 8.11, requirements.md §1.2 Could) — a
// realistic reinterpretation of the map toolbar's decorative "BIM Plans"
// button: real project plans (image/PDF), not a native BIM/IFC viewer
// (explicitly Won't v1). Reuses `MediaType` (only `image`/`document` ever
// populated here) instead of a dedicated enum.
model ProjectPlan {
  id        String    @id @default(uuid())
  projectId String
  name      String
  type      MediaType
  format    String
  size      Int
  url       String
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RefreshToken {
  id String @id @default(uuid())

  userId String

  // Unique, like `Invitation.tokenHash` and `ExportToken.tokenHash` (F9.5).
  // This model was the outlier, which mattered more than consistency: F9.4's
  // reuse detection is built on "one raw token names exactly one row", and
  // without the constraint that was an assumption the database never held up
  // — `AuthService.refresh` had to `findFirst` and would have silently picked
  // one row out of several. The values are SHA-256 of 64 random bytes, so no
  // real collision exists to migrate around.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String      @id @default(uuid())
  orgId      String
  incidentId String
  actorId    String
  action     AuditAction
  metadata   Json
  createdAt  DateTime    @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor        User         @relation("AuditActor", fields: [actorId], references: [id])

  @@index([incidentId])
}

model Notification {
  id          String           @id @default(uuid())
  orgId       String
  recipientId String
  incidentId  String
  type        NotificationType
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
}

// Org-scoped invites (requirements.md §1.5 — the "Share" button's functional
// reinterpretation). No ProjectMember model exists in this schema (a User
// belongs to exactly one Organization, and Project access is implicit at the
// org level), so an invite is org-scoped only; "project" collaboration in the
// roadmap wording resolves to the same thing here.
model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  email       String
  role        Role             @default(member)
  tokenHash   String           @unique
  invitedById String
  status      InvitationStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([orgId])
}

// Long-lived, per-user token that authenticates `GET /reports/dashboard-data`
// — deliberately distinct from the short-lived session JWT (roadmap 8.10,
// requirements.md §1.10 "Export and connect"): it's meant to be pasted once
// into an external tool (Power BI's Web connector, Looker Studio) as a stable
// URL, which a 15-minute access token can't be. Only its hash is persisted,
// same convention as Invitation.tokenHash/RefreshToken.tokenHash — the raw
// value is shown exactly once, at generation time. One token per user
// (`userId` unique); regenerating replaces it and invalidates the old link.
model ExportToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  orgId     String
  tokenHash String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([orgId])
}
