# Local PostgreSQL connection (see docs/data-model.md). Copy this file to
# .env and fill in the real values — .env is gitignored.
# On Railway (or any pooled/serverless target), append a low connection_limit
# (e.g. &connection_limit=3) — see best-practices.md §Prisma / SQL, needed
# because every Lambda cold start can open a new connection.
DATABASE_URL="postgresql://flyworkflow_app:password@localhost:5432/flyworkflow?schema=public"

# Local dev server port
PORT=3001

# Signs access tokens (JwtStrategy/AuthService). Generate a real one locally
# with `openssl rand -hex 32`; in AWS this becomes a SAM NoEcho parameter
# (F6.2), never a value committed here.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
# Refresh tokens are opaque random values stored hashed in RefreshToken.tokenHash,
# not JWTs — this only controls how long a rotation stays valid.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# S3StorageProvider (media uploads, F5.5). The bucket itself is provisioned by
# template.yaml (SAM), not created by hand — see aws-deploy-guide.md §8. No
# access key/secret here: locally the AWS CLI's default profile is used, and
# in AWS the Lambda execution role is used (best-practices.md §Security).
AWS_REGION="us-east-1"
S3_BUCKET_NAME="replace-with-the-sam-provisioned-bucket-name"
S3_PRESIGNED_URL_EXPIRES_IN_SECONDS=300
# How long a presigned *download* URL stays valid (F9.6). Longer than the
# upload one on purpose: an upload URL is spent seconds after it is issued,
# a download URL has to outlive however long someone leaves the gallery open.
S3_PRESIGNED_DOWNLOAD_EXPIRES_IN_SECONDS=1800

# Swagger UI + the OpenAPI schema at /api/docs (F9.4). Unset, it follows
# NODE_ENV: served everywhere except production, where publishing the full
# route inventory unauthenticated is free reconnaissance. Set to "true" to
# serve it in production anyway — a deliberate choice for a portfolio deploy,
# at the cost of the API's Content-Security-Policy, which has to come off for
# Swagger's inline bootstrap script to run (see bootstrap.ts).
ENABLE_API_DOCS=true

# CORS allow-list (bootstrap.ts) and the MediaBucket's S3 CORS rule
# (template.yaml). Defaults to the local Next.js dev server; in AWS this
# becomes the SAM `FrontendOrigin` parameter set to the real Vercel URL (F6.3).
FRONTEND_ORIGIN="http://localhost:3000"
