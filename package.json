{
  "name": "flyworkflow-incidencias",
  "description": "Frontend de gestión de incidencias para proyectos de construcción.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:db:up": "docker compose up -d --wait db",
    "e2e:db:down": "docker compose down -v",
    "generate-mock-data": "tsx scripts/generate-mock-data.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "./*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(backend)/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "./*.{json,scss,md}": [
      "prettier --write"
    ],
    "!(backend)/**/*.{json,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.18.0",
    "mapbox-gl": "^3.24.1",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.8.1",
    "sass": "^1.101.0",
    "supercluster": "^8.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
